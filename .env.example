# OrbitDesk configuration — copy to .env and adjust as needed. All values optional.

# OpenAI-compatible key for the AI assistant. Keep it server-side ONLY.
# Without it, every non-AI feature still works and the UI shows setup help.
OPENAI_API_KEY=
# Base URL and model of any OpenAI-compatible chat-completions API.
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# SQLite database file (created automatically). Swap to PostgreSQL later by
# replacing backend/app/db.py only.
ORBITDESK_DB_PATH=./data/orbitdesk.db
# Where Skyfield stores its leap-second/ephemeris data.
ORBITDESK_DATA_DIR=./data/skyfield

# Seconds between automatic CelesTrak refreshes (courtesy rate limit). Default 900.
ORBITDESK_CACHE_TTL_SECONDS=900
# Network timeout for CelesTrak fetches, seconds.
ORBITDESK_FETCH_TIMEOUT_SECONDS=15

# Set to true to never touch the network and use clearly-labeled bundled demo TLEs.
ORBITDESK_FORCE_DEMO_MODE=false

# DEBUG | INFO | WARNING | ERROR
ORBITDESK_LOG_LEVEL=INFO
